@page "/admin/courses"
@layout WorkshopHub.Web.Components.Layout.AdminLayout
@implements IAsyncDisposable
@inject BookingApiClient BookingApi
@inject DisplayFormatting Display

<PageTitle>Manage courses · WorkshopHub</PageTitle>
<div class="page-heading">
    <div>
        <p class="eyebrow">Shape the collection</p>
        <h1>Courses</h1>
        <p>Create a new opportunity, or keep an existing course up to date.</p>
    </div>
</div>
@if (_error is not null)
{
    <div class="notice error" role="alert">
        @_error
        <button class="button secondary small" @onclick="ReloadAsync" disabled="@_busy">
            Refresh records
        </button>
    </div>
}
@if (_success is not null)
{
    <div class="notice success" role="status">@_success</div>
}
@if (_archive is not null)
{
    <section class="panel confirmation" role="region" aria-labelledby="archive-title">
        <h2 id="archive-title">Archive @_archive.Title?</h2>
        <p>It will disappear from the public catalog and stop accepting new bookings. Existing bookings and their history
            are preserved.
        </p>
        <div class="actions">
            <button class="button danger" @onclick="ArchiveAsync" disabled="@_busy">
                @(_busy ? "Archiving…" : "Yes, archive course")
            </button>
            <button class="button secondary" @onclick="() => _archive = null" disabled="@_busy">
                Keep course
            </button>
        </div>
    </section>
}
<div class="admin-course-grid">
    <section aria-label="Course collection">
        <div class="panel toolbar">
            <div class="field"><label for="admin-course-search">Search courses</label><input id="admin-course-search"
                                                                                                 type="search" @bind="_search" @bind:event="oninput" placeholder="Search title or description" />
            </div><label class="check-field"><input type="checkbox" @bind="_showArchived" /> Include
            archived</label><button class="button secondary small" @onclick="ReloadAsync"
                                    disabled="@_busy">Refresh</button>
        </div>
        @if (_loading)
        {
            <div class="loading-state" role="status"><span class="spinner" aria-hidden="true"></span>Loading courses…</div>
        }
        else if (_courses.Count == 0 && _error is null)
        {

            <div class="empty-state">
                <h2>Your collection starts here</h2>
                <p>Create a course with the four fields on the right.</p>
            </div>
        }
        else if (!FilteredCourses.Any() && _error is null)
        {

            <div class="empty-state">
                <h2>No matching courses</h2>
                <p>Change the search or include archived courses.</p>
            </div>
        }
        else
        {
            <ul class="admin-course-list">
                @foreach (var course in FilteredCourses)
                {
                    <li class="panel admin-course-card" @key="course.Id">
                        <div class="section-heading">
                            <h2>@course.Title</h2><span
                            class="badge @(course.IsArchived ? "muted" : "available")">@(course.IsArchived ? "Archived" :
                            "Published")</span>
                        </div>
                        <p>@course.ShortDescription</p>
                        <div class="course-meta"><span>@Display.Price(course.Price)</span>
                            <span>
                                @course.OccupiedSeats / @course.MaximumParticipants seats occupied
                            </span>
                            <span class="caption">Revision
                                @course.Revision
                            </span>
                        </div>
                        <div class="actions">
                            <button class="button secondary small" @onclick="() => EditCourse(course)" disabled="@_busy">Edit
                                course
                            </button>
                            <a class="button secondary small" href="@($"/admin/bookings?courseId={course.Id}")">View
                                bookings
                            </a>
                            @if (!course.IsArchived)
                            {
                                <button class="text-link danger-text" @onclick="() => _archive = course" disabled="@_busy">
                                    Archive
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="panel course-editor" aria-labelledby="editor-title">
        <p class="eyebrow">@(_editing is null ? "Build something new" : "Keep it current")</p>
        <h2 id="editor-title">@(_editing is null ? "New course" : "Edit course")</h2>
        @if (_editing is not null)
        {
            <p class="caption">
                Editing revision @_editing.Revision. Existing receipts retain their booked title and price.
            </p>
        }
        <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="course-editor" @key="_form">
            <DataAnnotationsValidator />
            <fieldset disabled="@_busy">
                <div class="field">
                    <label for="course-title">Title</label>
                    <InputText id="course-title" @bind-Value="_form.Title" maxlength="80" /><span class="caption">A
                    clear title, up to 80 characters.</span>
                    <ValidationMessage For="() => _form.Title" />
                </div>
                <div class="field">
                    <label for="course-description">Short description</label>
                    <InputTextArea id="course-description" @bind-Value="_form.ShortDescription" maxlength="300"
                                   rows="4" />
                    <ValidationMessage For="() => _form.ShortDescription" />
                </div>
                <div class="form-row">
                    <div class="field">
                        <label for="course-price">Price (informational)</label>
                        <InputNumber id="course-price" @bind-Value="_form.Price" min="0" step="0.01" />
                        <ValidationMessage For="() => _form.Price" />
                    </div>
                    <div class="field"><label for="course-capacity">Maximum participants</label>
                        <InputNumber id="course-capacity" @bind-Value="_form.MaximumParticipants" min="1" />
                        <ValidationMessage For="() => _form.MaximumParticipants" />
                    </div>
                </div>
                <p class="caption">Capacity cannot be reduced below occupied seats. No payments or emails are processed.
                </p>
                <div class="actions">
                    <button class="button" type="submit">
                        @(_busy ? "Saving…" : _editing is null ? "Create course" : "Save changes")
                    </button>
                    @if (_editing is not null)
                    {
                        <button type="button" class="button secondary" @onclick="NewCourse">
                            Cancel edit
                        </button>
                    }
                </div>
            </fieldset>
        </EditForm>
    </section>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private List<AdminCourseResponse> _courses = [];
    private AdminCourseResponse? _editing;
    private AdminCourseResponse? _archive;
    private CourseForm _form = new();
    private string _search = "";
    private bool _showArchived;
    private bool _loading;
    private bool _busy;
    private string? _error;
    private string? _success;
    private IEnumerable<AdminCourseResponse> FilteredCourses => _courses.Where(x => (_showArchived || !x.IsArchived) &&
        (string.IsNullOrWhiteSpace(_search) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
x.ShortDescription.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    protected override Task OnInitializedAsync() => ReloadAsync();
    private void NewCourse() { _editing = null; _form = new(); _error = null; _success = null; }
    private void EditCourse(AdminCourseResponse course)
    {
        _editing = course;
        _form = new()
        {
            Title = course.Title,
            ShortDescription = course.ShortDescription,
            Price = course.Price,
            MaximumParticipants = course.MaximumParticipants
        };
        _error = null; _success = null; _archive = null;
    }
    private async Task ReloadAsync()
    {
        if (_loading) { return; }
        _loading = true;
        _error = null;
        try { _courses = await BookingApi.ListAdminCoursesAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (BookingApiException error) { _error = error.Message; }
        catch (Exception) { _error = "Courses couldn't be loaded. Check API readiness and refresh."; }
        finally { _loading = false; }
    }
    private async Task SaveAsync()
    {
        if (_busy) { return; }
        _busy = true; _error = null; _success = null;
        try
        {
            if (_editing is null)
            {
                await BookingApi.CreateCourseAsync(new(_form.Title, _form.ShortDescription, _form.Price,
_form.MaximumParticipants), _lifetime.Token);
            }
            else
            {
                await BookingApi.UpdateCourseAsync(_editing.Id, new(_form.Title, _form.ShortDescription, _form.Price,
_form.MaximumParticipants, _editing.Revision), _lifetime.Token);
            }
            _success = _editing is null ? "Course created and published in the catalog." : "Course changes saved. Existing booking receipts are unchanged.";
            _editing = null; _form = new();
            await ReloadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (BookingApiException error) { _error = error.Message + (error.StatusCode == System.Net.HttpStatusCode.Conflict ? " Your inputs are kept. Refresh and reopen the course to use its latest revision." : ""); }
        catch (Exception) { _error = "The save outcome is uncertain. Refresh records before submitting again; your inputs are kept."; }
        finally { _busy = false; }
    }
    private async Task ArchiveAsync()
    {
        if (_busy || _archive is null) { return; }
        _busy = true; _error = null; _success = null;
        try
        {
            await BookingApi.ArchiveCourseAsync(_archive.Id, _archive.Revision, _lifetime.Token); _archive = null; _success =
"Course archived. Existing bookings are preserved."; await ReloadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (BookingApiException error) { _error = error.Message + " Refresh records before trying again."; }
        catch (Exception) { _error = "The archive outcome is uncertain. Refresh records before retrying."; }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync() { await _lifetime.CancelAsync(); _lifetime.Dispose(); }
}
