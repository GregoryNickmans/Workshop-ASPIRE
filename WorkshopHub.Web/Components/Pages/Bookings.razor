@page "/"
@page "/courses"
@implements IAsyncDisposable
@inject BookingApiClient BookingApi
@inject DisplayFormatting Display

<PageTitle>Explore courses · WorkshopHub</PageTitle>
<section class="catalog-hero">
    <div>
        <p class="eyebrow">Make room for something new</p>
        <h1>Curiosity starts here<span class="accent">.</span></h1>
        <p class="hero-copy">A fresh perspective. A practical skill. Your next step.<br />Find a course that opens a
            little more possibility.
        </p>
        <a class="text-link" href="#catalog">Find your next course
            <span aria-hidden="true">↓</span>
        </a>
    </div>
    <div class="hero-art" aria-hidden="true">
        <span class="art-orbit orbit-one"></span>
        <span class="art-orbit orbit-two"></span>
        <span class="art-card"><span>KEEP<br />GROWING.</span>
            <i>↗</i>
        </span>
        <span class="art-dot"></span>
    </div>
</section>
<section id="catalog" aria-labelledby="catalog-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">The course collection</p>
            <h2 id="catalog-title">Choose your next chapter</h2>
        </div>
        <button class="button secondary small" @onclick="ReloadAsync" disabled="@_loading">Refresh courses</button>
    </div>
    <div class="catalog-filters">
        <div class="search-field">
            <label for="catalog-search">Search courses</label>
            <input id="catalog-search" type="search" placeholder="A title or something you want to learn…"
                   @bind="_search" @bind:event="oninput" />
        </div>
        <label class="check-field">
            <input type="checkbox" @bind="_availableOnly" /> Seats available only
        </label>
    </div>
    @if (_error is not null)
    {
        <div class="notice error" role="alert">
            @_error <button class="button secondary small" @onclick="ReloadAsync" disabled="@_loading">Try again</button>
        </div>
    }
    @if (_loading)
    {
        <div class="loading-state" role="status"><span class="spinner" aria-hidden="true"></span>Finding
            your next chapter…
        </div>
    }
    else if (_error is null && _courses.Count == 0)
    {

        <div class="empty-state">
            <h3>A new collection is on its way</h3>
            <p>No courses are currently available. Check back soon.</p>
        </div>
    }
    else if (_error is null && !FilteredCourses.Any())
    {

        <div class="empty-state">
            <h3>No courses match just yet</h3>
            <p>Try a different search or show all availability.</p>
            <button class="button secondary" @onclick="ClearFilters">Clear filters</button>
        </div>
    }
    else if (_error is null)
    {
        <p class="results-summary" role="status">@FilteredCourses.Count() course@(FilteredCourses.Count() == 1 ? "" : "s")
            to explore
        </p>
        <ul class="course-grid">
            @foreach (var course in FilteredCourses)
            {
                <li class="course-card" @key="course.Id">
                    <div class="course-card-top">
                        <span class="course-glyph" aria-hidden="true">↗</span>
                        <span class="badge @(course.RemainingSeats == 0 ? "muted" : "available")">
                            @(course.RemainingSeats == 0 ? "Fully booked" : $"{course.RemainingSeats} seats left")
                        </span>
                    </div>
                    <h3>@course.Title</h3>
                    <p class="course-description">@course.ShortDescription</p>
                    <div class="course-card-footer">
                        <div>
                            <span class="price">@Display.Price(course.Price)</span>
                            <span class="caption">per participant · no payment collected</span>
                        </div>
                        @if (course.RemainingSeats > 0)
                        {
                            <a class="button" href="@($"/courses/{course.Id}/book")">Book course
                                <span aria-hidden="true">↗</span>
                            </a>
                        }
                        else
                        {

                            <button class="button" disabled>Fully booked</button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private List<CourseResponse> _courses = [];
    private string _search = "";
    private bool _availableOnly;
    private bool _loading;
    private string? _error;
    private IEnumerable<CourseResponse> FilteredCourses => _courses.Where(x => (!_availableOnly || x.RemainingSeats > 0) &&
        (string.IsNullOrWhiteSpace(_search) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
x.ShortDescription.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    protected override Task OnInitializedAsync() => ReloadAsync();
    private void ClearFilters() { _search = ""; _availableOnly = false; }
    private async Task ReloadAsync()
    {
        if (_loading) { return; }
        _loading = true;
        _error = null;
        try { _courses = await BookingApi.ListCoursesAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (BookingApiException error) { _error = error.Message; }
        catch (Exception) { _error = "We couldn't load the catalog. Check that the API is running and try again."; }
        finally { _loading = false; }
    }
    public async ValueTask DisposeAsync() { await _lifetime.CancelAsync(); _lifetime.Dispose(); }
}
