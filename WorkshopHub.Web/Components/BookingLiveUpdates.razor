@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    [Parameter] public EventCallback<Guid?> OnChanged { get; set; }
    private IJSObjectReference? _module;
    private DotNetObjectReference<BookingLiveUpdates>? _receiver;
    private int? _subscription;
    private Task? _starting;
    private bool _disposed;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) { return Task.CompletedTask; }
        return _starting = StartAsync();
    }

    private async Task StartAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/booking-notifications.js");
            if (_disposed) { return; }
            _receiver = DotNetObjectReference.Create(this);
            _subscription = await _module.InvokeAsync<int>("start", _receiver);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* Optional signal: the page's manual refresh stays available. */ }
    }

    [JSInvokable]
    public Task BookingChanged(string? bookingId) => InvokeAsync(async () =>
    {
        if (!_disposed)
        {
            await OnChanged.InvokeAsync(Guid.TryParse(bookingId, out var id) ? id : null);
        }
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // A navigation may race the initial interop; wait before releasing its module/receiver.
        if (_starting is not null) { await _starting; }
        try
        {
            if (_module is not null)
            {
                if (_subscription is { } subscription) { await _module.InvokeVoidAsync("stop", subscription); }
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _receiver?.Dispose();
    }
}
